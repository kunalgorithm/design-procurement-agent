{
  "name": "design-procurement-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A conversational kitchen design and procurement assistant over Linq messaging.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "chat": "tsx --env-file-if-exists=.env scripts/chat.ts"
  },
  "dependencies": {
    "@linqapp/sdk": "^0.65.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "openai": "^7.13.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
