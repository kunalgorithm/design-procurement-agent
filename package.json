{
  "name": "design-procurement-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A conversational kitchen design and procurement assistant over Linq messaging.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "chat": "tsx --env-file-if-exists=.env scripts/chat.ts",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "predev": "npm run build:web"
  },
  "dependencies": {
    "@linqapp/sdk": "^0.65.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "openai": "^7.13.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.6",
    "react-hook-form": "^7.66.0",
    "valibot": "^1.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.10",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "express-rate-limit": "^8.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.2.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "tw-animate-css": "^1.4.0",
    "tailwindcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17"
  }
}
