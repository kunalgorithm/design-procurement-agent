PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/design_procurement_agent
# Admin /api endpoints and the /sandbox UI require this bearer token. Generate: openssl rand -hex 32
ADMIN_API_KEY=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# sandbox never sends messages to Linq. Change to live once configured.
MESSAGING_MODE=sandbox
# FORM design agent number shown after contractor signup, in international format.
LINQ_FROM_NUMBER=+16504447573
FORM_CONTACT_EMAIL=
FORM_CONTACT_WEBSITE=
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
# Optional comma-separated owned Linq handles. Restricts which lines accept events.
LINQ_ALLOWED_HANDLES=
# Sender numbers allowed to use /reset, /new, /pause, /resume, /status.
# Set privately, for example +12025550101,+12025550102.
LINQ_ADMIN_NUMBERS=
LOG_LEVEL=info
WORKER_POLL_MS=1000
# Number of different chats processed concurrently (1–4). Each chat remains ordered.
WORKER_CONCURRENCY=3
REPLY_DEBOUNCE_MS=1500
